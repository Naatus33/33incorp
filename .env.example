# Variáveis de Ambiente - Copie para .env.local e preencha com seus valores

# Contato
NEXT_PUBLIC_PHONE=+55 47 99999-9999
NEXT_PUBLIC_PHONE_DISPLAY=(47) 99999-9999
NEXT_PUBLIC_EMAIL=contato@33incorp.com.br
NEXT_PUBLIC_ADDRESS=Joinville, SC, Brasil

# Redes Sociais
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/group33incorp
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/group33incorp

# E-mail (para envio via API)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-app

# SendGrid (alternativa)
SENDGRID_API_KEY=sua-chave-sendgrid

# Analytics
NEXT_PUBLIC_GA_ID=UA-XXXXXXXXX-X

# Sentry (Error Tracking)
SENTRY_AUTH_TOKEN=seu-token-sentry
